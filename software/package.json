{
    "name": "angular-electron",
    "version": "0.0.0",
    "private": true,
    "main": "../dist/index.js",
    "scripts": {
        "start": "electron .",
        "dev": "npm run build && cross-env NODE_ENV=development npm run start",
        "debug": "npm run build && cross-env NODE_ENV=debug npm run start",
        "release": "npm run build && cross-env NODE_ENV=production npm run start",
        "build": "tsc && tsc-alias"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "^5.1.0",
        "@typescript-eslint/eslint-plugin": "^8.36.0",
        "@typescript-eslint/parser": "^8.36.0",
        "cross-env": "^7.0.3",
        "electron": "^37.2.1",
        "eslint": "^9.31.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^51.3.4",
        "eslint-plugin-prefer-arrow": "^1.2.3",
        "tsc-alias": "^1.8.16",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.36.0"
    },
    "dependencies": {
        "tslib": "^2.8.1"
    }
}
